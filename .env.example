# --- Opção A: Gemini API (AI Studio) — plano B se não houver projeto GCP no evento
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=cole_sua_chave_aqui

# --- Opção B: Gemini Enterprise Agent Platform (ex-Vertex AI) — preferida no evento
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1

# Modelo (confirme o ID no workshop; gemini-3.8-flash é GA desde 02/09/2026)
COPILOTO_MODEL=gemini-3.8-flash
# Modelo do agente de ação (quase só executa tools): vazio = mesmo do orquestrador.
# Com cota apertada, use a versão lite disponível no evento.
COPILOTO_MODEL_ACAO=
# Raciocínio: minimal | low | medium | high. Tokens de thinking contam na cota.
# Deixe vazio para modelos sem thinking_level (ex.: família 2.5).
COPILOTO_THINKING=low

# 1 = ações (parcelar/pagar) via servidor MCP do core mock; 0 = tools diretas
COPILOTO_USE_MCP=0

# Segredo da capacidade assinada (host e core MCP). Vazio = gerado a cada processo.
# Nunca publique nem deixe o cliente configurar.
# COPILOTO_AUTH_SECRET=

# Windows: evita erro de cp1252 no console
PYTHONUTF8=1

# --- Opção C: Integrações Gerenciadas do Ecossistema GCP (Opcionais)
# 1 = Usar Cloud Sensitive Data Protection (DLP API) para inspeção de PII nos guardrails
COPILOTO_USE_CLOUD_DLP=0

# Publicação de gatilhos proativos no Pub/Sub (ex: copiloto-gatilhos)
# COPILOTO_PUBSUB_TOPIC=copiloto-gatilhos

# 1 = Carregar faturas e perfis diretamente do BigQuery
COPILOTO_USE_BIGQUERY=0

# Porta do servidor web (Cloud Run define automaticamente via $PORT)
PORT=8080
